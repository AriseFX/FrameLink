    "precision": true,
    "gpu_conversion": false,
    "cursor": false
  },
  "hardware": {
    "sender_gpu": "Radeon RX 9070 XT",
    "receiver": "Same Windows machine; NDI 6.3.2 decoded BGRA memory"
  },
  "change": "Raise only the capture/send worker from THREAD_PRIORITY_NORMAL (0) to THREAD_PRIORITY_ABOVE_NORMAL (1). No process-priority, GPU-priority, affinity, or system timer changes in production.",
  "limitations": [
    "Controlled contention pins the capture worker to one logical CPU shared with a normal-priority synthetic busy process. This affinity is only applied by the private test harness.",
    "This is not a real game benchmark, not a cross-machine network test, and not an AI benchmark.",
    "Source drawing and earlier desktop composition, receiver application copies, display, GPU upload and AI are excluded.",
    "Short runs on a changing desktop demonstrate tail-latency resilience under this contention condition, not a universal latency or CPU-utilization improvement."
  ],
